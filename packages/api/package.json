{
    "name": "@alentapp/api",
    "version": "1.0.0",
    "type": "module",
    "main": "src/app.ts",
    "scripts": {
        "dev": "tsx watch src/app.ts",
        "test": "vitest",
        "test:e2e:prepare": "docker compose -f ../../docker-compose.e2e.yml --project-name alentapp-e2e up -d --wait db-test && DOTENV_CONFIG_PATH=.env.test prisma migrate deploy --config prisma.config.ts",
        "test:e2e:vitest": "DOTENV_CONFIG_PATH=.env.test vitest run src/delivery/*.e2e.test.ts",
        "test:e2e:sport:vitest": "DOTENV_CONFIG_PATH=.env.test vitest run src/delivery/Sport.e2e.test.ts",
        "test:e2e": "npm run test:e2e:vitest",
        "test:e2e:sport": "npm run test:e2e:sport:vitest",
        "coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@fastify/cors": "^11.2.0",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/auto-instrumentations-node": "^0.76.0",
        "@opentelemetry/exporter-prometheus": "^0.218.0",
        "@opentelemetry/instrumentation-fastify": "^0.56.0",
        "@opentelemetry/instrumentation-http": "^0.218.0",
        "@opentelemetry/sdk-node": "^0.218.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.7.0",
        "fastify": "^5.8.5"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/pg": "^8.20.0",
        "@vitest/coverage-v8": "^4.1.5",
        "dotenv": "^16.6.1",
        "pg": "^8.20.0",
        "prisma": "^6.19.3",
        "tsx": "^4.21.0",
        "vitest": "^4.1.5"
    }
}
